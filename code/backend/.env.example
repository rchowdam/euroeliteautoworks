# Copy to .env and fill in. Never commit .env.
# Default database: SQLite file in data/euroeliteautoworks.db
# DATABASE_URL=sqlite:///data/euroeliteautoworks.db

# Key for the office endpoints (GET/PATCH /api/enquiries), sent as the X-Admin-Key header.
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_KEY=

# Gallery photos and videos (uploaded at /admin).
# Locally they are saved in UPLOAD_DIR (default ./uploads).
# UPLOAD_DIR=./uploads
# With a bucket set they go to s3://<bucket>/media/ instead, uploaded straight from the browser.
# Needs AWS credentials (AWS_PROFILE or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) and the region.
# See "Photos & videos in S3" in README.md for the bucket's CORS and permission settings.
# S3_BUCKET=
# AWS_REGION=ap-south-1
# MAX_PHOTO_MB=15
# MAX_VIDEO_MB=300

# Comma-separated origins allowed to call the API from another address (default *)
# CORS_ORIGINS=https://euroeliteautoworks.com
